// ========================================
// Chart of Accounts — Hierarchical Groups
// ========================================

model AccountGroup {
  id              String         @id @default(cuid())
  code            String         @unique    // e.g. "4110", "5210" — standard COA numbering
  name            String                    // e.g. "OPD Revenue", "Staff Expenses"
  type            String                    // "ASSET" | "LIABILITY" | "EQUITY" | "REVENUE" | "EXPENSE" | "CONTRA"
  nature          String                    // "DEBIT" | "CREDIT"
  parentId        String?
  parent          AccountGroup?  @relation("AccountGroupTree", fields: [parentId], references: [id])
  children        AccountGroup[] @relation("AccountGroupTree")
  scope           String         @default("BOTH") // "HOSPITAL" | "PHARMACY" | "BOTH"
  isSystemAccount Boolean        @default(false)   // Prevent deletion of seeded accounts
  description     String?
  isActive        Boolean        @default(true)
  displayOrder    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([parentId])
  @@index([type])
  @@index([code])
  @@map("account_groups")
}

model Transaction {
  id               String           @id @default(cuid())
  date             DateTime         @default(now())
  accountId        String
  type             String
  amount           Float
  category         String
  paymentMethod    String
  scope            String           @default("HOSPITAL") // "HOSPITAL" | "PHARMACY"
  referenceId      String?
  description      String?
  createdAt        DateTime         @default(now())
  account          FinancialAccount @relation(fields: [accountId], references: [id])
  // Account group tagging for P&L / Balance Sheet generation
  accountGroupCode String?          // FK-like ref to AccountGroup.code (e.g. "4110")
  billingType      String?          // "OPD" | "IPD" | "PHARMACY" | "LAB" | "OT" etc.
  subCategory      String?          // Finer classification within category

  @@index([accountId])
  @@index([date])
  @@index([type])
  @@index([category])
  @@index([scope])
  @@index([accountGroupCode])
  @@index([billingType])
  @@map("transactions")
}

