model WhatsAppConversation {
  id           String            @id @default(cuid())
  patientId    String?
  phone        String            @unique
  status       String            @default("OPEN") // OPEN, CLOSED, BOT_HANDLING
  assignedToId String? // Staff ID
  messages     WhatsAppMessage[]
  updatedAt    DateTime          @updatedAt
  createdAt    DateTime          @default(now())

  patient    Patient? @relation(fields: [patientId], references: [id])
  assignedTo User?    @relation(fields: [assignedToId], references: [id])

  @@index([patientId])
  @@index([phone])
  @@index([status])
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String // INBOUND, OUTBOUND
  type           String // TEXT, IMAGE, DOCUMENT, BUTTON_REPLY
  content        String   @db.Text
  mediaUrl       String?
  status         String // SENT, DELIVERED, READ, RECEIVED
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model WhatsAppAutomationRule {
  id           String   @id @default(cuid())
  eventName    String   @unique // e.g., "LAB_RESULT_READY", "APPOINTMENT_REMINDER"
  isActive     Boolean  @default(true)
  templateId   String? // Maps to WhatsAppTemplate name
  delayMinutes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// MASTER FINANCE MODULE
// ═══════════════════════════════════════════════════════════════════

model FiscalYear {
  id        String   @id @default(cuid())
  name      String   // "2026-27"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("fiscal_years")
}

model Voucher {
  id            String         @id @default(cuid())
  voucherNumber String         @unique
  voucherType   String         // JOURNAL | RECEIPT | PAYMENT | CONTRA
  date          DateTime
  narration     String?
  totalAmount   Float
  status        String         @default("POSTED") // DRAFT | POSTED | CANCELLED
  createdBy     String
  entries       VoucherEntry[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([date])
  @@index([voucherType])
  @@index([status])
  @@map("vouchers")
}

model VoucherEntry {
  id               String  @id @default(cuid())
  voucherId        String
  accountGroupCode String  // Debit or Credit account (from Chart of Accounts)
  financialAccountId String?
  debitAmount      Float   @default(0)
  creditAmount     Float   @default(0)
  narration        String?
  costCenterId     String?
  voucher          Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount? @relation(fields: [financialAccountId], references: [id])

  @@index([voucherId])
  @@index([accountGroupCode])
  @@index([financialAccountId])
  @@map("voucher_entries")
}

// ═══════════════════════════════════════════════════════════════════
// BUDGETING & COST CENTERS
// ═══════════════════════════════════════════════════════════════════

model CostCenter {
  id          String           @id @default(cuid())
  name        String           @unique
  code        String           @unique
  type        String           // REVENUE | SUPPORT | ADMIN
  parentId    String?
  isActive    Boolean          @default(true)
  allocations CostAllocation[]
  budgets     Budget[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("cost_centers")
}

model CostAllocation {
  id           String     @id @default(cuid())
  costCenterId String
  expenseType  String     // RENT | ELECTRICITY | HOUSEKEEPING | SECURITY | IT | INSURANCE
  percentage   Float      // 0-100
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([costCenterId, expenseType])
  @@map("cost_allocations")
}

model Budget {
  id           String       @id @default(cuid())
  costCenterId String
  fiscalYear   String       // "2026-27"
  month        Int?         // null = annual, 1-12 = monthly
  status       String       @default("DRAFT") // DRAFT | APPROVED | LOCKED
  items        BudgetItem[]
  costCenter   CostCenter   @relation(fields: [costCenterId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([costCenterId, fiscalYear, month])
  @@map("budgets")
}

model BudgetItem {
  id               String @id @default(cuid())
  budgetId         String
  accountGroupCode String
  budgetedAmount   Float
  notes            String?
  budget           Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("budget_items")
}

// ═══════════════════════════════════════════════════════════════════
// EXPENSE APPROVALS
// ═══════════════════════════════════════════════════════════════════

model ExpenseRequest {
  id            String            @id @default(cuid())
  requestedBy   String
  department    String
  category      String            // CAPEX | OPEX | TRAVEL | SUPPLIES | REPAIR | OTHER
  description   String
  amount        Float
  status        String            @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  currentLevel  Int               @default(1)
  attachments   String[]
  approvals     ExpenseApproval[]
  costCenterId  String?
  voucherId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@map("expense_requests")
}

model ExpenseApproval {
  id              String         @id @default(cuid())
  expenseId       String
  approverUserId  String
  approverName    String?
  level           Int
  action          String         // APPROVED | REJECTED
  remarks         String?
  actedAt         DateTime       @default(now())
  expense         ExpenseRequest @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_approvals")
}

model ApprovalPolicy {
  id            String  @id @default(cuid())
  level         Int
  roleRequired  String  // DEPARTMENT_HEAD | FINANCE_MANAGER | ADMIN
  maxAmount     Float?
  department    String?

  @@map("approval_policies")
}

model IPDCustomCharge {
  id              String       @id @default(cuid())
  admissionId     String
  category        String       @default("ADDON")
  name            String
  amount          Float
  quantity        Int          @default(1)
  discountPercent Float        @default(0)
  discountAmount  Float        @default(0)
  totalAmount     Float
  date            DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  admission       IPDAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([category])
  @@map("ipd_custom_charges")
}
