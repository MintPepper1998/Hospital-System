generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PatientFeedback {
  id          String         @id @default(cuid())
  patientId   String
  type        FeedbackType
  subject     String
  message     String
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedBy  String?
  resolveNote String?
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("patient_feedbacks")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  emailVerified         DateTime?
  phone                 String?
  name                  String?
  password              String?
  image                 String?
  signatureUrl          String?
  role                  Role                   @default(PATIENT)
  permissions           String[]               @default([])
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accounts              Account[]
  auditLogs             AuditLog[]
  employee              Employee?
  createdCamps          MedicalCamp[]          @relation("CampCreator")
  operations            Operation[]            @relation("OperationDoctor")
  patient               Patient?
  sessions              Session[]
  staff                 Staff?
  temporaryPermissions  TemporaryPermission[]
  whatsAppConversations WhatsAppConversation[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model TemporaryPermission {
  id         String    @id @default(cuid())
  userId     String
  permission String
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  grantedBy  String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("temporary_permissions")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model RoleTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  baseRole    Role
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("role_templates")
}

model Staff {
  id                   String                     @id @default(cuid())
  userId               String                     @unique
  employeeId           String                     @unique
  department           String?
  designation          String?
  specialization       String?
  licenseNumber        String?
  phone                String?
  emergencyContact     String?
  address              String?
  joiningDate          DateTime                   @default(now())
  consultationFee      Float                      @default(500)
  basicSalary          Float?
  isOnLeave            Boolean                    @default(false)
  leaveReason          String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  idCardImage          String?
  rfidTag              String?                    @unique
  opdCustomPaperUrl    String?
  signatureUrl         String?
  ipdAssignments       IPDNurseAssignment[]
  ambulanceAssignments AmbulanceStaffAssignment[]
  appointments         Appointment[]              @relation("DoctorAppointments")
  casualtyVisits       CasualtyVisit[]            @relation("CasualtyDoctor")
  doctorSchedules      DoctorSchedule[]
  emergencyVisits      EmergencyVisit[]           @relation("EREmergencyDoctor")
  erShifts             ERDoctorShift[]            @relation("ERDoctorShifts")
  ipdAdmissions        IPDAdmission[]             @relation("IPDPrimaryDoctor")
  onlineBookings       OnlineBooking[]            @relation("OnlineBookingDoctor")
  otSchedules          OTSchedule[]
  rosters              Roster[]                   @relation("StaffRosters")
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances          StaffAttendance[]
  surgeries            Surgery[]                  @relation("SurgeryLeadSurgeon")
  surgeryAssignments   SurgeryStaffAssignment[]
  ipdAdmissionDoctors  IPDAdmissionDoctor[]
  recordedVitals       PatientVital[]

  @@index([employeeId])
  @@index([department])
  @@map("staff")
}

model StaffAttendance {
  id               String    @id @default(cuid())
  staffId          String
  checkInTime      DateTime?
  checkOutTime     DateTime?
  latitude         Float?
  longitude        Float?
  deviceIP         String?
  deviceInfo       String?
  isWithinGeofence Boolean   @default(false)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  date             DateTime  @db.Date
  halfDayTime      String?
  recordedBy       String?
  status           String    @default("PRESENT")
  checkInMethod    String?
  staff            Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
  @@map("staff_attendance")
}

model Employee {
  id            String         @id @default(cuid())
  userId        String?        @unique
  name          String
  role          String
  department    String
  basicSalary   Float          @default(0)
  signatureUrl  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User?          @relation(fields: [userId], references: [id])
  salaryRecords SalaryRecord[]

  @@index([name])
  @@index([role])
  @@index([department])
  @@map("employees")
}

model SalaryRecord {
  id            String   @id @default(cuid())
  employeeId    String
  month         String
  year          Int
  amountPaid    Float
  bonus         Float    @default(0)
  deductions    Float    @default(0)
  paymentDate   DateTime @default(now())
  status        String   @default("PAID")
  transactionId String?
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@index([paymentDate])
  @@map("salary_records")
}

model Patient {
  id                       String                 @id @default(cuid())
  userId                   String                 @unique
  patientId                String                 @unique
  dateOfBirth              DateTime?
  gender                   Gender?
  bloodGroup               String?
  phone                    String?
  emergencyContact         String?
  emergencyContactName     String?
  emergencyContactRelation String?
  address                  String?
  city                     String?
  state                    String?
  pincode                  String?
  medicalHistory           String?
  allergies                String?
  currentMedications       String?
  maritalStatus            String?
  occupation               String?
  fatherOrHusbandName      String?
  fatherSpouseName         String?
  motherName               String?
  nationality              String?                @default("Indian")
  religion                 String?
  referredBy               String?
  profilePhotoUrl          String?
  aadharNumber             String?                @unique
  aadharCardUrl            String?
  isBsky                   Boolean                @default(false)
  bskyNumber               String?
  bskyCardUrl              String?
  pastMedicalHistory       String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  bedTransfers             BedTransferHistory[]
  ambulanceTrips           AmbulanceTrip[]
  appointments             Appointment[]
  billings                 Billing[]
  casualtyVisits           CasualtyVisit[]
  emergencyVisits          EmergencyVisit[]
  insurancePolicies        InsurancePolicy[]
  ipdAdmissions            IPDAdmission[]
  labOrders                LabOrder[]
  labRequests              LabRequest[]
  medicalRecords           MedicalRecord[]
  operations               Operation[]
  documents                PatientDocument[]
  feedbacks                PatientFeedback[]
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  preAuthorizations        PreAuthorization[]
  prescriptions            Prescription[]
  salesReturns             SalesReturn[]
  surgeries                Surgery[]
  whatsAppConversations    WhatsAppConversation[]

  @@index([patientId])
  @@index([phone])
  @@index([createdAt])
  @@index([isBsky])
  @@index([aadharNumber])
  @@map("patients")
}

model PatientDocument {
  id         String   @id @default(cuid())
  patientId  String
  title      String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([uploadedAt])
  @@map("patient_documents")
}

model Appointment {
  id                      String            @id @default(cuid())
  patientId               String
  doctorId                String
  appointmentDate         DateTime
  appointmentTime         String
  duration                Int               @default(30)
  status                  AppointmentStatus @default(PENDING)
  reason                  String?
  notes                   String?
  chiefComplaint          String?
  diagnosis               String?
  prescription            String?
  pulse                   String?
  temperature             String?
  weight                  String?
  height                  String?
  bloodPressure           String?
  spo2                    String?
  symptoms                String?
  historyOfPresentIllness String?
  vitalsTakenBy           String?
  vitalsTakenAt           DateTime?
  advisedAdmission        Boolean           @default(false)
  admissionReason         String?
  admissionNotes          String?
  advisedSurgery          Boolean           @default(false)
  advisedSurgeryName      String?
  surgeryUrgency          String?
  surgeryNotes            String?
  casualtyVisitId         String?
  source                  String? // "OPD" | "CASUALTY" — null defaults to OPD
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  casualtyVisit           CasualtyVisit?    @relation(fields: [casualtyVisitId], references: [id])
  doctor                  Staff             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient                 Patient           @relation(fields: [patientId], references: [id])
  billings                Billing[]
  labRequests             LabRequest[]
  medicalRecords          MedicalRecord[]
  vitals                  PatientVital[]

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([casualtyVisitId])
  @@index([createdAt])
  @@index([status])
  @@map("appointments")
}

model MedicalRecord {
  id             String         @id @default(cuid())
  patientId      String
  appointmentId  String?
  chiefComplaint String?
  diagnosis      String?
  vitals         Json?
  symptoms       String?
  examination    String?
  treatment      String?
  followUpDate   DateTime?
  recordDate     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])
  prescriptions  Prescription[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([recordDate])
  @@map("medical_records")
}

model Prescription {
  id               String             @id @default(cuid())
  patientId        String
  medicalRecordId  String?
  prescribedBy     String
  prescriptionDate DateTime           @default(now())
  validUntil       DateTime?
  instructions     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  emergencyVisitId String?
  medications      PrescriptionItem[]
  emergencyVisit   EmergencyVisit?    @relation(fields: [emergencyVisitId], references: [id])
  medicalRecord    MedicalRecord?     @relation(fields: [medicalRecordId], references: [id])
  patient          Patient            @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([prescriptionDate])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  medicationName String
  dosage         String
  frequency      String
  duration       String
  quantity       Int
  instructions   String?
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model OTSchedule {
  id                String   @id @default(cuid())
  otRoomNumber      String
  patientName       String
  patientId         String?
  surgeonId         String
  surgeryType       String
  scheduledDate     DateTime
  scheduledTime     String
  estimatedDuration Int
  status            OTStatus @default(SCHEDULED)
  anesthesiaType    String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  surgeon           Staff    @relation(fields: [surgeonId], references: [id])

  @@index([otRoomNumber])
  @@index([scheduledDate])
  @@index([status])
  @@map("ot_schedules")
}

model Ward {
  id          String   @id @default(cuid())
  name        String
  type        String
  floor       String?
  capacity    Int      @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  beds        Bed[]

  @@index([name])
  @@index([type])
  @@index([isActive])
  @@map("wards")
}

model Bed {
  id              String               @id @default(cuid())
  wardId          String
  bedNumber       String
  pricePerDay     Float
  status          BedStatus            @default(AVAILABLE)
  features        String?
  lastCleaned     DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  transfersFrom   BedTransferHistory[] @relation("FromBed")
  transfersTo     BedTransferHistory[] @relation("ToBed")
  ward            Ward                 @relation(fields: [wardId], references: [id], onDelete: Cascade)
  emergencyVisits EmergencyVisit[]     @relation("ERBed")
  admissions      IPDAdmission[]

  @@unique([wardId, bedNumber])
  @@index([wardId])
  @@index([status])
  @@map("beds")
}

model EmergencyVisit {
  id                   String               @id @default(cuid())
  patientId            String?
  triageLevel          TriageLevel          @default(NON_URGENT)
  chiefComplaint       String?
  vitalsRecorded       String?
  assignedDoctorId     String?
  bedId                String?
  status               EmergencyStatus      @default(TRIAGING)
  arrivalTime          DateTime             @default(now())
  dischargeTime        DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  adviceOnDischarge    String?
  conditionAtDischarge String?
  courseInHospital     String?
  finalDiagnosis       String?
  followUpDate         DateTime?
  proceduresDone       String?
  treatmentGiven       String?
  billings             Billing[]
  mealOrders           CanteenMealOrder[]
  canteenDiets         CanteenPatientDiet[]
  recordedVitals       PatientVital[]
  clinicalNotes        ClinicalNote[]
  discharge            Discharge?
  assignedDoctor       Staff?               @relation("EREmergencyDoctor", fields: [assignedDoctorId], references: [id])
  bed                  Bed?                 @relation("ERBed", fields: [bedId], references: [id])
  patient              Patient?             @relation(fields: [patientId], references: [id])
  ipdAdmissions        IPDAdmission[]
  equipmentUsages      IPDEquipmentUsage[]
  ipdLabRequests       IPDLabRequest[]
  ipdPrescriptions     IPDPrescription[]
  labRequests          LabRequest[]
  prescriptions        Prescription[]

  @@index([patientId])
  @@index([assignedDoctorId])
  @@index([bedId])
  @@index([createdAt])
  @@index([status])
  @@map("emergency_visits")
}

model CasualtyVisit {
  id               String         @id @default(cuid())
  patientId        String
  chiefComplaint   String?
  status           CasualtyStatus @default(ADMITTED)
  arrivalTime      DateTime       @default(now())
  dischargeTime    DateTime?
  assignedDoctorId String?
  vitals           String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patient        Patient             @relation(fields: [patientId], references: [id])
  assignedDoctor Staff?              @relation("CasualtyDoctor", fields: [assignedDoctorId], references: [id])
  procedures     CasualtyProcedure[]
  appointments   Appointment[]
  billings       Billing[]

  @@index([patientId])
  @@index([assignedDoctorId])
  @@index([createdAt])
  @@index([status])
  @@map("casualty_visits")
}

model CasualtyProcedure {
  id              String   @id @default(cuid())
  casualtyVisitId String
  name            String
  category        String   @default("GENERAL")
  description     String?
  quantity        Int      @default(1)
  unitPrice       Float    @default(0)
  performedBy     String?
  performedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  casualtyVisit CasualtyVisit @relation(fields: [casualtyVisitId], references: [id])

  @@index([casualtyVisitId])
  @@map("casualty_procedures")
}

model IPDAdmission {
  id                     String                 @id @default(cuid())
  ipNumber               String?                @unique
  patientId              String
  bedId                  String
  primaryDoctorId        String
  admissionDate          DateTime               @default(now())
  dischargeDate          DateTime?
  status                 IPDAdmissionStatus     @default(ADMITTED)
  initialDeposit         Float
  totalCharges           Float                  @default(0)
  reason                 String?
  diagnosis              String?
  treatmentPlan          String?
  dischargeNotes         String?
  dischargeSummary       String?
  dischargeType          DischargeType?
  dischargeTypeCode      String?
  customDischargeData    Json?
  finalDiagnosis         String?
  proceduresDone         String?
  courseInHospital       String?
  treatmentGiven         String?
  conditionAtDischarge   String?
  adviceOnDischarge      String?
  followUpDate           DateTime?
  totalBedCharges        Float                  @default(0)
  totalLabCharges        Float                  @default(0)
  totalPharmacyCharges   Float                  @default(0)
  totalOtherCharges      Float                  @default(0)
  totalBillAmount        Float                  @default(0)
  amountPaid             Float                  @default(0)
  balanceDue             Float                  @default(0)
  isBskyAdmission        Boolean                @default(false)
  filesHandedOver        Boolean                @default(false)
  discountAmount         Float                  @default(0)
  discountPercent        Float                  @default(0)
  discountType           String?
  discountReason         String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  sourceEmergencyVisitId String?
  bedTransfers           BedTransferHistory[]
  assignedNurses         IPDNurseAssignment[]
  ambulanceTrips         AmbulanceTrip[]
  billings               Billing[]
  canteenOrders          CanteenMealOrder[]
  canteenDiets           CanteenPatientDiet[]
  clinicalNotes          ClinicalNote[]
  discharge              Discharge?
  bed                    Bed                    @relation(fields: [bedId], references: [id])
  patient                Patient                @relation(fields: [patientId], references: [id])
  primaryDoctor          Staff                  @relation("IPDPrimaryDoctor", fields: [primaryDoctorId], references: [id])
  sourceEmergencyVisit   EmergencyVisit?        @relation(fields: [sourceEmergencyVisitId], references: [id])
  equipmentUsages        IPDEquipmentUsage[]
  ipdLabRequests         IPDLabRequest[]
  ipdPrescriptions       IPDPrescription[]
  doctors                IPDAdmissionDoctor[]
  vitals                 PatientVital[]
  timelineEvents         PatientTimelineEvent[]
  dischargeMedicines     DischargeMedicine[]
  customCharges          IPDCustomCharge[]

  @@index([patientId])
  @@index([bedId])
  @@index([primaryDoctorId])
  @@index([status])
  @@index([admissionDate])
  @@index([sourceEmergencyVisitId])
  @@index([createdAt])
  @@index([isBskyAdmission])
  @@index([dischargeType])
  @@map("ipd_admissions")
}

model ClinicalNote {
  id               String          @id @default(cuid())
  admissionId      String?
  authorId         String
  authorName       String?
  date             DateTime        @default(now())
  note             String
  medications      String?
  labTests         String?
  bp               String?
  pulse            String?
  temperature      String?
  spO2             String?
  respiratoryRate  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  emergencyVisitId String?
  admission        IPDAdmission?   @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  emergencyVisit   EmergencyVisit? @relation(fields: [emergencyVisitId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([date])
  @@index([emergencyVisitId])
  @@index([authorId])
  @@map("clinical_notes")
}

model IPDPrescription {
  id                String                @id @default(cuid())
  admissionId       String?
  prescribedById    String
  prescribedByName  String?
  medicineName      String
  dosage            String
  frequency         String
  duration          String
  instruction       String?
  requestedQuantity Int?
  status            IPDPrescriptionStatus @default(ACTIVE)
  pharmacyStatus    IPDPharmacyStatus     @default(PENDING)
  dispensedAt       DateTime?
  dispensedBy       String?
  dispensedQuantity Int?
  unitPrice         Float?
  totalPrice        Float?
  batchAllocations  Json? // [{ batchId, batchNumber, units, sellingPrice }]
  stoppedAt         DateTime?
  stoppedBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  emergencyVisitId  String?
  admission         IPDAdmission?         @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  emergencyVisit    EmergencyVisit?       @relation(fields: [emergencyVisitId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([status])
  @@index([emergencyVisitId])
  @@index([pharmacyStatus])
  @@index([createdAt])
  @@map("ipd_prescriptions")
}

model IPDLabRequest {
  id               String          @id @default(cuid())
  admissionId      String?
  testCatalogId    String?
  orderedById      String
  orderedByName    String?
  type             TestType
  testName         String
  status           IPDLabStatus    @default(PENDING)
  isUrgent         Boolean         @default(false)
  notes            String?
  result           String?
  parameterResults Json?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelledBy      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  emergencyVisitId String?
  admission        IPDAdmission?   @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  emergencyVisit   EmergencyVisit? @relation(fields: [emergencyVisitId], references: [id], onDelete: Cascade)
  testCatalog      LabTestCatalog? @relation(fields: [testCatalogId], references: [id])

  @@index([admissionId])
  @@index([testCatalogId])
  @@index([type])
  @@index([status])
  @@index([emergencyVisitId])
  @@index([createdAt])
  @@map("ipd_lab_requests")
}

model Discharge {
  id               String          @id @default(cuid())
  admissionId      String?         @unique
  dischargeDate    DateTime        @default(now())
  type             DischargeType   @default(NORMAL)
  summary          String?
  preparedBy       String?
  totalBillAmount  Float           @default(0)
  amountPaid       Float           @default(0)
  balanceDue       Float           @default(0)
  insuranceCovered Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  emergencyVisitId String?         @unique
  admission        IPDAdmission?   @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  emergencyVisit   EmergencyVisit? @relation(fields: [emergencyVisitId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([dischargeDate])
  @@index([type])
  @@map("discharges")
}

model DischargeMedicine {
  id                String       @id @default(cuid())
  admissionId       String
  medicineId        String? // FK to pharmacy Medicine (null = legacy free-text row)
  medicineName      String
  dosage            String
  frequency         String
  duration          String
  quantity          Int          @default(0) // prescribed quantity (units)
  instruction       String?
  pharmacyStatus    String       @default("PENDING") // PENDING | DISPENSED | CANCELLED
  dispensedAt       DateTime?
  dispensedBy       String?
  dispensedQuantity Int?
  unitPrice         Float? // weighted average across batches used
  totalPrice        Float?
  batchAllocations  Json? // [{ batchId, units, sellingPrice }]
  billingId         String? // PHARMACY Billing created on dispense
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  admission         IPDAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  medicine          Medicine?    @relation(fields: [medicineId], references: [id])

  @@index([admissionId])
  @@index([medicineId])
  @@index([pharmacyStatus])
  @@map("discharge_medicines")
}

model OperationTheater {
  id            String      @id @default(cuid())
  name          String      @unique
  type          TheaterType @default(MAJOR)
  floor         String?
  capacity      Int?
  isOperational Boolean     @default(true)
  equipment     String?
  features      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  surgeries     Surgery[]

  @@map("operation_theaters")
}

model Surgery {
  id                   String                   @id @default(cuid())
  patientId            String
  leadSurgeonId        String
  assistantSurgeons    String?
  anesthetistName      String?
  anesthetistId        String?
  theaterId            String
  procedureName        String
  procedureCode        String?
  category             String?
  scheduledDate        DateTime
  durationMinutes      Int
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  status               SurgeryStatus            @default(SCHEDULED)
  pacStatus            PACStatus                @default(PENDING)
  pacNotes             String?
  pacCheckedBy         String?
  pacCheckedAt         DateTime?
  diagnosis            String?
  findings             String?
  procedureNotes       String?
  complications        String?
  bloodLoss            String?
  estimatedCost        Float?
  actualCost           Float?
  consumables          Json?
  billingId            String?
  isEmergency          Boolean                  @default(false)
  cancellationReason   String?
  procedureTemplateId  String?
  chargeBreakdown      Json?
  paymentStatus        OTPaymentStatus          @default(PENDING)
  paymentMethod        String?
  surgeryCharge        Float                    @default(0)
  consentFormUrl       String?
  anaesthesiaRecordUrl String?
  operationNoteUrl     String?
  operationImages      Json?
  operationVideo       String?
  // ── PAC Assessment (structured) ──
  pacAssessment        Json?                    // Full structured PAC form data
  // ── WHO Safety Checklists ──
  whoSignIn            Json?                    // WHO Sign-In checklist (before anesthesia)
  whoTimeOut           Json?                    // WHO Time-Out checklist (before incision)
  whoSignOut           Json?                    // WHO Sign-Out checklist (before leaving OR)
  // ── Workflow tracking ──
  surgeryStartedBy     String?                  // Staff ID who marked surgery as started
  surgeryCompletedBy   String?                  // Staff ID who marked surgery as completed
  // ── Post-operative documentation ──
  postOpNotes          Json?                    // Structured post-op documentation
  specimenDetails      String?                  // Specimen information
  spongeCountVerified  Boolean                  @default(false)
  instrumentCountVerified Boolean               @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  billing              Billing?                 @relation(fields: [billingId], references: [id])
  leadSurgeon          Staff                    @relation("SurgeryLeadSurgeon", fields: [leadSurgeonId], references: [id])
  patient              Patient                  @relation(fields: [patientId], references: [id])
  theater              OperationTheater         @relation(fields: [theaterId], references: [id])
  staffAssignments     SurgeryStaffAssignment[]

  @@index([patientId])
  @@index([leadSurgeonId])
  @@index([theaterId])
  @@index([scheduledDate])
  @@index([status])
  @@index([billingId])
  @@index([createdAt])
  @@index([pacStatus])
  @@map("surgeries")
}

model SurgeryStaffAssignment {
  id            String   @id @default(cuid())
  surgeryId     String
  staffId       String
  role          String // e.g., 'Assistant Surgeon', 'Anesthetist', 'Scrub Nurse', 'Technician'
  paymentAmount Float    @default(0)
  status        String   @default("PENDING") // PENDING, PAID
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  surgery Surgery @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([surgeryId])
  @@index([staffId])
  @@map("surgery_staff_assignments")
}

model Supplier {
  id               String            @id @default(cuid())
  name             String            @unique
  contactPerson    String?
  phone            String?
  email            String?
  gstNumber        String?           @unique
  address          String?
  city             String?
  state            String?
  pincode          String?
  isActive         Boolean           @default(true)
  creditDays       Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  openingBalance   Float             @default(0)
  // PHARMACY, HOSPITAL, or BOTH. BOTH preserves compatibility for existing suppliers.
  scope            String            @default("BOTH")
  inventoryBatches InventoryBatch[]
  purchases        PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  purchaseOrders   PurchaseOrder[]
  challans         Challan[]
  supplierPayments SupplierPayment[]

  @@index([name])
  @@index([gstNumber])
  @@index([isActive])
  @@index([scope])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  orderNumber  String              @unique
  date         DateTime            @default(now())
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  totalAmount  Float               @default(0)
  notes        String?
  createdBy    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  items     PurchaseOrderItem[]
  invoiceId String?             @unique
  invoice   PurchaseInvoice?    @relation(fields: [invoiceId], references: [id])

  @@index([supplierId])
  @@index([date])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  medicineId      String
  quantity        Int
  unitCost        Float  @default(0)
  totalCost       Float  @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@index([purchaseOrderId])
  @@index([medicineId])
  @@map("purchase_order_items")
}

model MedicineCustomType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("medicine_custom_types")
}

model Medicine {
  id                        String                     @id @default(cuid())
  name                      String
  genericName               String
  manufacturer              String?
  strength                  String?
  unitPrice                 Float
  minStockLevel             Int                        @default(100)
  hsnCode                   String?
  schedule                  String?
  composition               String?
  sideEffects               String?
  usage                     String?
  storageLocation           String?
  isActive                  Boolean                    @default(true)
  noLooseSale               Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  type                      String                     @default("TABLET")
  inventoryBatches          InventoryBatch[]
  purchaseItems             PurchaseItem[]
  purchaseReturnItems       PurchaseReturnItem[]
  surgeryProcedureMedicines SurgeryProcedureMedicine[]
  purchaseOrderItems        PurchaseOrderItem[]
  challanItems              ChallanItem[]
  dischargeMedicines        DischargeMedicine[]

  @@unique([name, strength])
  @@index([name])
  @@index([genericName])
  @@index([type])
  @@index([isActive])
  @@map("medicines")
}

model InventoryBatch {
  id                String                @id @default(cuid())
  medicineId        String
  batchNumber       String
  supplierId        String
  quantity          Int
  originalQuantity  Int
  purchasePrice     Float
  sellingPrice      Float
  manufactureDate   DateTime?
  expiryDate        DateTime
  purchaseDate      DateTime              @default(now())
  grnNumber         String?
  invoiceNumber     String?
  invoiceDate       DateTime?
  isExpired         Boolean               @default(false)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  medicinesPerStrip Int                   @default(1)
  taxPercent        Float                 @default(12.0)
  medicine          Medicine              @relation(fields: [medicineId], references: [id])
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  stockAdjustments  StockAdjustmentItem[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([supplierId])
  @@index([expiryDate])
  @@index([isActive])
  @@index([isExpired])
  @@map("inventory_batches")
}

model StockAdjustment {
  id         String                @id @default(cuid())
  date       DateTime              @default(now())
  reason     String
  notes      String?
  adjustedBy String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  items      StockAdjustmentItem[]

  @@index([date])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String   @id @default(cuid())
  stockAdjustmentId String
  inventoryBatchId  String
  medicineId        String
  quantityChange    Int // e.g. -5 for waste, +10 for found stock
  unitCost          Float    @default(0) // snapshot of cost at time of adjustment
  createdAt         DateTime @default(now())

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  inventoryBatch  InventoryBatch  @relation(fields: [inventoryBatchId], references: [id])

  @@index([stockAdjustmentId])
  @@index([inventoryBatchId])
  @@map("stock_adjustment_items")
}

model LabTestCatalog {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  price          Float
  category       String?
  type           TestType        @default(PATHOLOGY)
  normalRange    String?
  unit           String?
  parameters     Json?
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ipdLabRequests IPDLabRequest[]

  @@index([code])
  @@index([category])
  @@index([type])
  @@index([isActive])
  @@map("lab_test_catalog")
}

model LabRequest {
  id               String           @id @default(cuid())
  appointmentId    String?
  patientId        String
  orderedBy        String
  testCatalogId    String
  testName         String
  testPrice        Float
  testType         TestType         @default(PATHOLOGY)
  status           LabRequestStatus @default(PENDING_PAYMENT)
  billingId        String?
  priority         String           @default("ROUTINE")
  notes            String?
  reportContent    String?
  impression       String?
  parameterResults Json?
  completedAt      DateTime?
  performedBy      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  emergencyVisitId String?
  appointment      Appointment?     @relation(fields: [appointmentId], references: [id])
  billing          Billing?         @relation(fields: [billingId], references: [id])
  emergencyVisit   EmergencyVisit?  @relation(fields: [emergencyVisitId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  results          LabResult[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([billingId])
  @@index([status])
  @@index([testType])
  @@index([emergencyVisitId])
  @@index([createdAt])
  @@map("lab_requests")
}

model LabResult {
  id          String     @id @default(cuid())
  requestId   String
  testName    String
  resultValue String
  unit        String?
  normalRange String?
  remarks     String?
  enteredBy   String?
  enteredAt   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  request     LabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("lab_results")
}

model LabOrder {
  id        String    @id @default(cuid())
  patientId String
  orderedBy String
  orderDate DateTime  @default(now())
  priority  String    @default("ROUTINE")
  status    String    @default("PENDING")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  patient   Patient   @relation(fields: [patientId], references: [id])
  tests     LabTest[]

  @@index([patientId])
  @@index([orderDate])
  @@index([status])
  @@map("lab_orders")
}

model LabTest {
  id          String    @id @default(cuid())
  labOrderId  String
  testName    String
  testCode    String?
  result      String?
  resultDate  DateTime?
  normalRange String?
  unit        String?
  status      String    @default("PENDING")
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  labOrder    LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)

  @@index([labOrderId])
  @@index([testName])
  @@map("lab_tests")
}

model Billing {
  id                 String             @id @default(cuid())
  billNumber         String             @unique
  patientId          String
  appointmentId      String?
  type               BillingType        @default(PHARMACY)
  billDate           DateTime           @default(now())
  totalAmount        Float
  discountAmount     Float              @default(0)
  taxAmount          Float              @default(0)
  netAmount          Float
  paidAmount         Float              @default(0)
  balanceAmount      Float
  status             BillingStatus      @default(PENDING)
  paymentMethod      String?
  transactionId      String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  roundOff           Float              @default(0)
  pharmacyCustomerId String?
  emergencyVisitId   String?
  casualtyVisitId    String?
  ipdAdmissionId     String?
  // Split payment amounts (structured storage)
  splitCashAmount    Float?
  splitUpiAmount     Float?
  splitCardAmount    Float?
  // IPD settlement tracking (hospital → pharmacy)
  settlementStatus   String? // null | "PENDING" | "SETTLED"
  settledAt          DateTime?
  settledBy          String?
  ambulanceBillings  AmbulanceBilling[]
  items              BillingItem[]
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id])
  casualtyVisit      CasualtyVisit?     @relation(fields: [casualtyVisitId], references: [id])
  emergencyVisit     EmergencyVisit?    @relation(fields: [emergencyVisitId], references: [id])
  ipdAdmission       IPDAdmission?      @relation(fields: [ipdAdmissionId], references: [id])
  patient            Patient            @relation(fields: [patientId], references: [id])
  pharmacyCustomer   PharmacyCustomer?  @relation(fields: [pharmacyCustomerId], references: [id])
  insuranceClaims    InsuranceClaim[]
  labRequests        LabRequest[]
  payments           Payment[]
  salesReturns       SalesReturn[]
  surgeries          Surgery[]

  @@index([billNumber])
  @@index([patientId])
  @@index([appointmentId])
  @@index([pharmacyCustomerId])
  @@index([billDate])
  @@index([status])
  @@index([type])
  @@index([emergencyVisitId])
  @@index([casualtyVisitId])
  @@index([ipdAdmissionId])
  @@index([createdAt])
  @@index([settlementStatus])
  @@map("billings")
}

model PharmacyCustomer {
  id        String    @id @default(cuid())
  name      String
  phone     String?   @unique
  address   String?
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  billings  Billing[]

  @@index([phone])
  @@index([name])
  @@map("pharmacy_customers")
}

model BillingItem {
  id              String    @id @default(cuid())
  billingId       String
  description     String
  quantity        Int       @default(1)
  unitPrice       Float
  amount          Float
  gstRate         Float     @default(0)
  gstAmount       Float     @default(0)
  totalAmount     Float
  serviceCategory String?
  serviceDate     DateTime?
  performedBy     String?
  referenceId     String?
  unitCost        Float?    // purchase cost per unit at time of sale (null = unknown/legacy)
  costAmount      Float?    // total cost of goods sold for this line, rounded 2dp
  createdAt       DateTime  @default(now())
  billing         Billing   @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@index([billingId])
  @@index([serviceCategory])
  @@map("billing_items")
}

model Payment {
  id            String        @id @default(cuid())
  billingId     String
  paymentDate   DateTime      @default(now())
  amount        Float
  method        PaymentMethod @default(CASH)
  paymentMethod String?
  transactionId String?
  reference     String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime      @default(now())
  billing       Billing       @relation(fields: [billingId], references: [id])

  @@index([billingId])
  @@index([paymentDate])
  @@index([method])
  @@map("payments")
}

model InsurancePolicy {
  id                   String              @id @default(cuid())
  patientId            String
  policyNumber         String              @unique
  schemeType           InsuranceSchemeType @default(PRIVATE)
  providerName         String
  providerContact      String?
  tpaName              String?
  tpaId                String?
  healthCardNumber     String?
  policyType           String?
  corporateName        String?
  employeeId           String?
  coverageAmount       Float
  balanceAvailable     Float?
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean             @default(true)
  roomRentCap          Float?
  roomRentCapType      String?
  icuRentCap           Float?
  copayPercentage      Float?              @default(0)
  deductibleAmount     Float?              @default(0)
  deductibleType       String?
  subLimits            Json?
  waitingPeriods       Json?
  exclusions           Json?
  ayushmanId           String?
  abhaNumber           String?
  pmjayFamilyId        String?
  pmjayPackageEligible Json?
  bskyCardNumber       String?
  isNetworkHospital    Boolean             @default(true)
  negotiatedTariff     Json?
  verificationStatus   VerificationStatus  @default(PENDING)
  verifiedAt           DateTime?
  verifiedBy           String?
  verificationNotes    String?
  apiProviderId        String?
  lastApiSync          DateTime?
  apiResponseData      Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  claims               InsuranceClaim[]
  patient              Patient             @relation(fields: [patientId], references: [id])
  preAuthorizations    PreAuthorization[]

  @@index([patientId])
  @@index([policyNumber])
  @@index([schemeType])
  @@index([ayushmanId])
  @@index([bskyCardNumber])
  @@map("insurance_policies")
}

model InsuranceClaim {
  id                    String               @id @default(cuid())
  policyId              String
  billingId             String?
  preAuthId             String?
  claimNumber           String               @unique
  claimType             InsuranceClaimType   @default(CASHLESS)
  claimDate             DateTime             @default(now())
  claimAmount           Float
  approvedAmount        Float?
  settledAmount         Float?
  deductions            Json?
  copayAmount           Float?
  deductibleApplied     Float?
  roomRentExcess        Float?
  nonAdmissibleAmount   Float?
  totalPatientLiability Float?
  status                InsuranceClaimStatus @default(SUBMITTED)
  remarks               String?
  tpaReferenceNumber    String?
  documents             Json?
  bankAccountNumber     String?
  bankName              String?
  bankIfsc              String?
  panNumber             String?
  submittedAt           DateTime             @default(now())
  acknowledgedAt        DateTime?
  settledAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  billing               Billing?             @relation(fields: [billingId], references: [id])
  policy                InsurancePolicy      @relation(fields: [policyId], references: [id])

  @@index([policyId])
  @@index([billingId])
  @@index([claimNumber])
  @@index([status])
  @@index([claimType])
  @@map("insurance_claims")
}

model PreAuthorization {
  id                          String          @id @default(cuid())
  preAuthNumber               String          @unique
  policyId                    String
  patientId                   String
  admissionId                 String?
  appointmentId               String?
  provisionalDiagnosis        String
  icdPrimaryCode              String?
  icdPrimaryDescription       String?
  icdSecondaryCode            String?
  icdSecondaryDescription     String?
  comorbidity1Code            String?
  comorbidity1Description     String?
  comorbidity2Code            String?
  comorbidity2Description     String?
  treatmentType               String?
  proposedTreatment           String
  surgeryName                 String?
  surgeryIcdPcsCode           String?
  admissionType               String?
  expectedStayDays            Int?
  expectedIcuDays             Int?
  roomType                    String?
  roomChargePerDay            Float?
  estimatedRoomRent           Float?
  estimatedIcuCharges         Float?
  estimatedInvestigation      Float?
  estimatedOtCharges          Float?
  estimatedProfessionalFees   Float?
  estimatedMedicines          Float?
  estimatedImplants           Float?
  estimatedOtherCharges       Float?
  totalEstimatedCost          Float
  status                      PreAuthStatus   @default(DRAFT)
  approvedAmount              Float?
  approvedRemarks             String?
  queryDetails                String?
  rejectionReason             String?
  enhancementAmount           Float?
  enhancementReason           String?
  enhancementStatus           String?
  finalBillAmount             Float?
  dischargeApprovedAmount     Float?
  dischargeRemarks            String?
  documents                   Json?
  treatingDoctorName          String?
  treatingDoctorRegNo         String?
  treatingDoctorQualification String?
  submittedAt                 DateTime?
  approvedAt                  DateTime?
  dischargeRequestedAt        DateTime?
  dischargeApprovedAt         DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  patient                     Patient         @relation(fields: [patientId], references: [id])
  policy                      InsurancePolicy @relation(fields: [policyId], references: [id])

  @@index([preAuthNumber])
  @@index([policyId])
  @@index([patientId])
  @@index([status])
  @@map("pre_authorizations")
}

model TariffMaster {
  id               String   @id @default(cuid())
  category         String
  code             String?
  description      String
  hospitalRate     Float
  insurerRates     Json?
  pmjayPackageCode String?
  pmjayRate        Float?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([category, code])
  @@index([category])
  @@index([pmjayPackageCode])
  @@map("tariff_master")
}

model IcdCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String
  category    String?
  isCommon    Boolean @default(false)

  @@index([code])
  @@index([category])
  @@map("icd_codes")
}

model MedicalCamp {
  id            String   @id @default(cuid())
  campName      String
  location      String
  address       String?
  campDate      DateTime
  startTime     String?
  endTime       String?
  focusArea     String?
  organizer     String?
  contactPerson String?
  contactNumber String?
  expectedCount Int?
  actualCount   Int      @default(0)
  description   String?
  status        String   @default("PLANNED")
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation("CampCreator", fields: [createdById], references: [id])

  @@index([campDate])
  @@index([status])
  @@map("medical_camps")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  module    String
  recordId  String?
  ipAddress String?
  userAgent String?
  changes   Json?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([timestamp])
  @@map("audit_logs")
}

model Notification {
  id            String    @id @default(cuid())
  title         String
  message       String
  type          String    @default("INFO")
  module        String
  link          String?
  referenceId   String?
  targetUserId  String?
  targetRole    Role?
  scheduledFor  DateTime?
  isRead        Boolean   @default(false)
  readAt        DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([targetUserId])
  @@index([targetRole])
  @@index([isRead])
  @@index([createdAt])
  @@index([module])
  @@index([scheduledFor])
  @@map("notifications")
}

model GeofenceConfig {
  id              String   @id @default(cuid())
  locationName    String
  centerLatitude  Float
  centerLongitude Float
  radiusMeters    Float    @default(100)
  isActive        Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("geofence_configs")
}

model Shift {
  id                   String                     @id @default(cuid())
  name                 String                     @unique
  code                 String                     @unique
  startTime            String
  endTime              String
  color                String?
  icon                 String?
  description          String?
  isActive             Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  ambulanceAssignments AmbulanceStaffAssignment[]
  rosters              Roster[]

  @@index([isActive])
  @@map("shifts")
}

model Roster {
  id        String   @id @default(cuid())
  staffId   String
  shiftId   String
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shift     Shift    @relation(fields: [shiftId], references: [id])
  staff     Staff    @relation("StaffRosters", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId])
  @@index([shiftId])
  @@index([date])
  @@map("rosters")
}

model HospitalSettings {
  id                     Int      @id @default(1)
  name                   String   @default("Shree Kamal Hospital")
  address                String   @default("")
  phone                  String   @default("")
  email                  String   @default("")
  website                String   @default("")
  gstNo                  String?
  logoUrl                String?
  letterheadHeaderUrl    String?
  letterheadFooterUrl    String?
  rohiniId               String?
  nabhAccreditation      String?
  pmjayHospitalId        String?
