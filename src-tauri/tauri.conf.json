{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shree Kamal Hospital",
  "version": "1.0.0",
  "identifier": "com.shree-kamal-hospital.app",
  "build": {
    "frontendDist": "https://main.d2m7fwsk1mjtdf.amplifyapp.com",
    "devUrl": "https://main.d2m7fwsk1mjtdf.amplifyapp.com/login",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shree Kamal Hospital",
        "fullscreen": true,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Shree Kamal Hospital",
        "url": "data:text/html;base64,",
        "width": 480,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Shree Kamal Hospital",
    "shortDescription": "Shree Kamal Hospital - Staff Management System",
    "longDescription": "Shree Kamal Hospital Enterprise Resource Planning system for hospital staff management, patient records, billing, pharmacy, and clinical operations.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.ico"
      }
    }
  },
  "plugins": {}
}
